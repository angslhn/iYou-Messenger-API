{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "sourceMap": false,
    "declaration": false,
    "removeComments": true,
    "ignoreDeprecations": "6.0",
    "incremental": false,
    "tsBuildInfoFile": null
  },
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**",
    "jest.config.ts",
    "node_modules",
    "dist"
  ]
}
