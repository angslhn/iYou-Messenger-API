{
  "name": "iyou_messenger_api",
  "version": "1.0.0",
  "author": "Aang Solihin",
  "description": "REST API & WebSocket server untuk iYou Messenger. Menghadirkan fitur real-time private & group chat, autentikasi OTP JWT, manajemen pertemanan, story 24-jam, dan keamanan anti-spam menggunakan Node.js dan PostgreSQL.",
  "type": "module",
  "main": "./dist/index.js",
  "keywords": [
    "iyou-messenger",
    "chat-api",
    "realtime-chat",
    "websocket",
    "express",
    "nodejs",
    "postgresql",
    "typescript",
    "jwt-authentication",
    "otp-verification",
    "cloudinary",
    "group-chat",
    "rate-limiting"
  ],
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv-flow": "^3.3.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv-flow": "^4.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nanoid": "^5.1.9",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.59.1"
  }
}
